DATABASE_URL=postgres://warehouse:warehouse_local@localhost:5432/warehouse?sslmode=disable
PORT=8080
LOG_LEVEL=INFO
# Used only by integration tests. Must be a disposable database.
TEST_DATABASE_URL=postgres://warehouse:warehouse_local@localhost:5432/warehouse_test?sslmode=disable
# Optional lookup cache. Leave REDIS_URL empty to disable caching.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=60s
# Redis integration tests use unique key prefixes and never flush the database.
TEST_REDIS_URL=redis://localhost:6379/15
