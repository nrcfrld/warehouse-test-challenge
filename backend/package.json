{
  "name": "@warehouse/backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "go run ./cmd/api",
    "build": "go build -trimpath -o bin/api ./cmd/api",
    "lint": "go vet ./... && go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0 run",
    "typecheck": "go vet ./...",
    "test": "go test -race ./...",
    "test:integration": "go test -race -tags=integration -count=1 ./internal/...",
    "db:migrate": "go run ./cmd/migrate",
    "db:seed": "go run ./cmd/seed",
    "db:demo": "go run ./cmd/seed -demo"
  }
}
