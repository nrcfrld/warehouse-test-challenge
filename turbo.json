{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "backend/go.mod",
    "backend/go.sum",
    "backend/docs/openapi.yaml",
    "scripts/tasks.mjs"
  ],
  "globalEnv": ["TOOLCHAIN_CACHE_KEY"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "API_PROXY_TARGET",
        "LOG_LEVEL",
        "REDIS_URL",
        "REDIS_CACHE_TTL"
      ]
    },
    "build": {
      "outputs": ["dist/**", "bin/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_REDIS_URL"]
    }
  }
}
